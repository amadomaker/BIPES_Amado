FROM httpd:latest

WORKDIR /usr/local/apache2/htdocs

# Copia a landing para a raiz do servidor
COPY ui/landing.html ./

# Copia o restante da UI para a subpasta /ui
COPY ui ./ui

# Configura o Apache para abrir a landing como página inicial
RUN sed -i 's/DirectoryIndex .*/DirectoryIndex landing.html/' /usr/local/apache2/conf/httpd.conf && \
    echo "ServerName localhost" >> /usr/local/apache2/conf/httpd.conf

EXPOSE 80

CMD ["httpd", "-D", "FOREGROUND"]
